{
  "name": "airbrb-backend",
  "version": "2.0.0",
  "description": "AirBrB Backend API - Serverless TypeScript",
  "main": "api/index.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node -r dotenv/config api/index.ts",
    "type-check": "tsc --noEmit",
    "test": "jest test/*",
    "lint": "eslint api/**/*.ts",
    "start:legacy": "nodemon -r esm src/server.js --ignore database.json",
    "reset": "npx rimraf database.json",
    "db:migrate": "node database/migrate.js",
    "db:reset": "node database/migrate.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/pg": "^8.15.6",
    "@vercel/node": "^3.0.0",
    "async-lock": "^1.2.4",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "swagger-ui-express": "^4.1.4",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.12.1",
    "@types/async-lock": "^1.4.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "babel-cli": "^6.26.0",
    "babel-core": "^6.26.3",
    "babel-jest": "^26.6.1",
    "babel-loader": "^8.1.0",
    "babel-preset-env": "^1.7.0",
    "eslint": "^8.56.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^26.6.0",
    "typescript": "^5.3.3",
    "vercel": "^33.0.0"
  }
}
